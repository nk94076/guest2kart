PORT=3000

# Admin panel (CMS) login - /admin
ADMIN_USER=admin
ADMIN_PASS=change-this-password

# SMTP settings for sending emails (example: Gmail with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Guest2Kart <your-email@gmail.com>"

# Optional: you also get a copy of every new lead here
ADMIN_NOTIFY_EMAIL=your-email@gmail.com
